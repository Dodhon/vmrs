{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/restart_claude_desktop.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "vmrs-test-runner",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/save_vmrs_result.py",
            "timeout": 30000
          }
        ]
      }
    ]
  }
}
