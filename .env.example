# Neo4j Connection Configuration
# Copy this file to .env and fill in your actual credentials
# DO NOT commit .env to git!

# Neo4j Connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_secure_password_here
NEO4J_DATABASE=neo4j

# Import Batch Sizes
BATCH_SIZE_SYSTEMS=100
BATCH_SIZE_ASSEMBLIES=1000
BATCH_SIZE_COMPONENTS=5000
BATCH_SIZE_RELATIONSHIPS=10000

# File Paths (relative to project root)
VMRS_CSV_PATH=csv data/VMRS_COMPLETE_v20_MASTER.csv

# Source Tracking (usually don't need to change)
VMRS_SOURCE=vmrs_handbook
VMRS_VERSION=v20

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/vmrs_import.log
